# Copie este arquivo para .env e preencha os valores. NUNCA commite o .env.

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Modelo usado na classificação (troque se quiser outro)
ANTHROPIC_MODEL=claude-haiku-5-5

# Chave simples para proteger o endpoint (o Make envia no header X-API-Key).
# Gere algo longo e aleatório. Se deixar vazio, o endpoint fica aberto (só use assim local).
API_KEY=troque_por_um_segredo_longo

# Abaixo dessa confiança, a mensagem é marcada para revisão humana (0.0 a 1.0)
LIMIAR_CONFIANCA=0.6

# URL do webhook do Make (usada só pelo script scripts/enviar_exemplos.py).
# Cole a sua no .env local. NÃO coloque a URL real neste arquivo nem no GitHub.
MAKE_WEBHOOK_URL=https://hook.us2.make.com/COLE_AQUI_O_ID_DO_SEU_WEBHOOK
